# Threat Hunting Platform — Environment Variables
# Copy to .env and fill in your values.

# Platform
TH_DEBUG=false
TH_ENVIRONMENT=production
TH_LOG_LEVEL=INFO
TH_JSON_LOGS=true

# Database
DB_BACKEND=sqlite
DB_URL=sqlite+aiosqlite:///./data/threat_hunting.db

# Redis
REDIS_URL=redis://localhost:6379/0

# MISP
MISP_URL=https://your-misp.example.com
MISP_KEY=your-misp-api-key
MISP_VERIFY_SSL=true

# OPSEC
OPSEC_DEFAULT_PROXY=
OPSEC_TOR_PROXY=socks5://127.0.0.1:9050

# API Keys (optional — platform still works without them, but is rate-limited)
# Set these per-connector as needed:
# GITHUB_TOKEN=ghp_...
# ALIENVAULT_OTX_KEY=...
# THREATFOX_KEY=...
# PASTEBIN_KEY=...
# VIRUSTOTAL_KEY=...
